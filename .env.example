# Copy this file to .env and fill in your LINE channel credentials.
# Get these from https://developers.line.biz/console/ -> your channel -> Messaging API tab

# Channel access token (long-lived token recommended)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# Channel secret (Webhook secret, from the same Messaging API tab)
LINE_CHANNEL_SECRET=your_channel_secret_here

# Server port
PORT=3000
